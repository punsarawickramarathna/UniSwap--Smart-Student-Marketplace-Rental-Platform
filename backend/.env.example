# Backend settings. Put these in the project root .env or backend/.env.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/uniswap
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
ALLOWED_STUDENT_EMAIL_DOMAINS=horizoncampus.edu.lk
REFRESH_COOKIE_SECURE=false

# Gmail requires an App Password for the sender account, not its login password.
MAIL_FROM=your-sender@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-sender@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_USE_STARTTLS=true
# Port 465 is also supported and uses implicit TLS automatically.
